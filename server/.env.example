# ==========================================================================
# BRISOFT SHOP - CONFIGURAÇÕES DO SERVIDOR
# ==========================================================================

PORT=3010
NODE_ENV=development

# Segurança (use valores longos e exclusivos em produção)
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
BOOTSTRAP_ADMIN_EMAIL=admin@empresa.com
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-temporaria
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:5180

# Conexão Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=chat-media
SUPABASE_SESSION_BUCKET=whatsapp-sessions
CLOUD_STORAGE_ENABLED=false
SHOP_DEMO_MODE=true

# WhatsApp Settings
WHATSAPP_SESSION_NAME=brisoft-shop-session
WHATSAPP_AUTO_RECONNECT=false
WHATSAPP_RECONNECT_MAX_ATTEMPTS=8
WHATSAPP_RECONNECT_BASE_MS=5000
WHATSAPP_RECONNECT_MAX_MS=300000
WHATSAPP_MESSAGE_CONCURRENCY=10
WHATSAPP_MAX_PENDING_MESSAGES=10000
WHATSAPP_RETRY_CACHE_HOURS=24
WHATSAPP_MAX_MEDIA_MB=25
WHATSAPP_MEDIA_RETENTION_DAYS=30
WHATSAPP_MEDIA_CLEANUP_HOURS=6

# IA gratuita de teste (nunca coloque a chave no frontend)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_COMPANY_ID=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_LIMIT=20

# WhatsApp Cloud API oficial: apenas número de teste fornecido pela Meta
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_MODE=test
WHATSAPP_COMPANY_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_RECIPIENTS=
# Mapeamento explícito wa_id -> telefone verificado para envio no sandbox
WHATSAPP_TEST_RECIPIENT_MAP={}
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_DAILY_LIMIT=50
